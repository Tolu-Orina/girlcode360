# Public site origin used for Open Graph / canonical URLs (no trailing slash)
VITE_PUBLIC_SITE_URL=https://www.girlcode360.com

# Cognito (from SSM in CI). Required with VITE_API_BASE_URL — API Gateway
# rejects the local Bearer dev.* token (401). Localhost is already an allowed
# Cognito callback; this is auth, not CORS.
# VITE_COGNITO_USER_POOL_ID=
# VITE_COGNITO_CLIENT_ID=
# VITE_COGNITO_REGION=eu-west-2
# VITE_COGNITO_DOMAIN=girlcode360-dev.auth.eu-west-2.amazoncognito.com
# VITE_COGNITO_GOOGLE_IDP=true
# VITE_API_BASE_URL=

# Local Mirror. Never prefix with VITE_. If this is set, `npm run dev`
# skips Cognito/Google and Vite calls YouCam S2S itself (skin scan).
# YOUCAM_API_KEY=
# YOUCAM_API_SERVER=https://yce-api-01.makeupar.com
